# --- Database ---
# Production: your on-prem server, reached via VPN/SSH tunnel from the cloud backend.
# Local dev with `docker compose up -d` (see docker-compose.yml): use
#   postgresql+asyncpg://feedback_user:devpassword@localhost:5442/feedback_portal
DATABASE_URL=postgresql+asyncpg://feedback_user:changeme@10.0.0.5:5432/feedback_portal

# --- Admin JWT session cookie ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Set to true once served over HTTPS in production
COOKIE_SECURE=false

# --- Bootstrap admin account (created on startup if no admin exists yet) ---
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme-strong-password

# --- CORS: comma-separated frontend origins ---
FRONTEND_ORIGINS=http://localhost:5173

# --- Rate limiting for the public submission endpoint ---
SUBMIT_RATE_LIMIT=5/hour

# --- Trust X-Forwarded-For from your reverse proxy/load balancer (set true only if you control it) ---
TRUST_PROXY_HEADERS=false
