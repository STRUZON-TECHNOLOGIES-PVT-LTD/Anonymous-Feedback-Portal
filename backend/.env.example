# --- Environment ---
# "production" (default if unset) REFUSES to start with weak secrets / COOKIE_SECURE=true
# and disables /docs. Use "development" for local work only.
ENVIRONMENT=production

# --- Database ---
# Production: your on-prem server, reached via VPN/SSH tunnel from the cloud backend.
# Local dev with `docker compose up -d` (see docker-compose.yml): use
#   postgresql+asyncpg://feedback_user:devpassword@localhost:5442/feedback_portal
DATABASE_URL=postgresql+asyncpg://feedback_user:changeme@10.0.0.5:5432/feedback_portal

# --- Admin JWT session cookie ---
# >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Must be true in production (HTTPS). Set false only with ENVIRONMENT=development
COOKIE_SECURE=true

# --- Bootstrap admin account (created on startup if no admin exists yet) ---
ADMIN_BOOTSTRAP_USERNAME=admin
# >= 12 chars, not a placeholder
ADMIN_BOOTSTRAP_PASSWORD=changeme-strong-password

# --- CORS: comma-separated frontend origins ---
FRONTEND_ORIGINS=http://localhost:5173

# --- Rate limiting for the public submission endpoint ---
SUBMIT_RATE_LIMIT=5/hour

# --- Login brute-force protection ---
LOGIN_RATE_LIMIT=5/minute
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- X-Forwarded-For: enable ONLY behind a proxy you control that appends the real client IP.
# TRUSTED_PROXY_HOPS = number of your proxies; client IP is read that many entries from the right. ---
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
